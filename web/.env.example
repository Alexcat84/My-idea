# Fase 3.0. Copiar a .env.local para desarrollo; en Vercel, configurar
# estas mismas variables en Project Settings > Environment Variables.
# NUNCA commitear .env.local ni valores reales (ya gitignored).

# Mismo proyecto Supabase que ya usa el CLI (engine/.env: SUPABASE_URL).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Los mismos dos valores para el servidor.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only, jamas exponer al cliente (bypassa RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Mismo valor que engine/.env: ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=

# Server-only. Nuevo para Fase 3.0: brujula semantica (Voyage AI en vez de
# sentence-transformers, que es Python y no viaja a la web).
VOYAGE_API_KEY=

# Server-only. Rate limiting en beta (patron Upstash del proyecto I Ching).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pre-beta (fusible): tope global diario de arranques de TODA la app.
# Default 30 si no se define; 0 lo desactiva (palanca de reversión).
FUSIBLE_SESIONES_DIA=
# Arranques por identidad al día (default 5).
LIMITE_ARRANQUES_DIA=
# Identidad del límite: por defecto IP (sin auth real). "usuario" revierte
# a user-id cuando llegue el clon de cuentas.
RATE_LIMIT_POR=

# Borrado real (26 sep 2026): secreto con el que Vercel llama a la tarea
# programada /api/cron/limpiar-invitados (vercel.json). Sin él, la tarea falla
# cerrada y no borra nada. Generarlo largo y aleatorio; configurarlo en Vercel.
CRON_SECRET=

# Server-only. Correos del doble factor (Resend) y cifrado del TOTP
# (64 hex cada secreto). Ver el .env.example de la raíz.
RESEND_API_KEY=
TOTP_ENCRYPTION_KEY=
TWO_FACTOR_EMAIL_CODE_SECRET=
TWO_FACTOR_EMAIL_FROM=

# Server-only. i18n F6 (D4): secreto del Send Email Hook de Supabase
# ("v1,whsec_...", lo genera Supabase en Authentication > Hooks). Lo lee
# /api/auth/hook-correo para verificar la firma; sin él, rechaza todo.
# Usa también RESEND_API_KEY y TWO_FACTOR_EMAIL_FROM. Ver docs/i18n/F6_CORREOS.md.
SEND_EMAIL_HOOK_SECRET=

# Presupuesto por sesión en dólares (vacío = 0.35) y muestreo del juez.
PRESUPUESTO_SESION_USD=
JUEZ_SESION_MUESTREO=

# Solo los arneses de desarrollo (vuelos): el dev user y adónde apuntan.
VUELO_DEV_PASSWORD=
VUELO_BASE_URL=
